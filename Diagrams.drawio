        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nleft to right direction\nskinparam packageStyle rectangle\n\nactor \&quot;Користувач\&quot; as User\n\nrectangle \&quot;Табличний редактор (Avalonia UI)\&quot; {\n    usecase \&quot;Введення та редагування значень / формул\&quot; as UC1\n    usecase \&quot;Обчислення виразів (Arithmetic, div, mod, ^)\&quot; as UC2\n    usecase \&quot;Керування розміром сітки (+/- Рядок, +/- Стовпець)\&quot; as UC3\n    usecase \&quot;Очищення таблиці\&quot; as UC4\n    usecase \&quot;Експорт таблиці на Google Drive\&quot; as UC5\n    usecase \&quot;Імпорт таблиці з Google Drive\&quot; as UC6\n    usecase \&quot;Вибір файлу зі списку Drive\&quot; as UC7\n}\n\nUser --&gt; UC1\nUser --&gt; UC2\nUser --&gt; UC3\nUser --&gt; UC4\nUser --&gt; UC5\nUser --&gt; UC6\n\nUC1 ..&gt; UC2 : &lt;&lt;include&gt;&gt;\nUC6 ..&gt; UC7 : &lt;&lt;include&gt;&gt;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="FO80cQonKfeMptUv1j8--1">
