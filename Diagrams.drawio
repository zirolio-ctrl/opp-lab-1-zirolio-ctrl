  <diagram id="0mH_8EV-5ImKTXnzMWzX" name="Страница-2">
    <mxGraphModel dx="1704" dy="946" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam classAttributeIconSize 0\n\nclass Program {\n    {static} + Main(string[] args)\n    {static} + BuildAvaloniaApp() : AppBuilder\n}\n\nclass App {\n    + Initialize() : void\n    + OnFrameworkInitializationCompleted() : void\n}\n\nclass MainWindow {\n    - int _rowCount\n    - int _colCount\n    - const double RowHeaderWidth\n    - const double CellWidth\n    - const double HeaderHeight\n    - const double CellHeight\n    - string _selectedCell\n    - GoogleDriveService? _googleDriveService\n    - readonly SpreadsheetEngine _engine\n    + MainWindow()\n    - RenderGrid() : void\n    - CreateHeader(string text) : Border\n    - CreateCell(string cellName) : Border\n    - SelectCell(string cellName) : void\n    - ApplyFormula() : void\n    - GetGoogleDriveService() : GoogleDriveService\n    - OnExportClicked(object? sender, RoutedEventArgs e) : void\n    - OnImportClicked(object? sender, RoutedEventArgs e) : void\n    - SelectDriveFileAsync(IList&lt;DriveFile&gt; files) : Task&lt;DriveFile?&gt;\n    - OnFormulaSubmitted(object sender, RoutedEventArgs e) : void\n    - OnFormulaKeyed(object sender, KeyEventArgs e) : void\n    - OnAddRowClicked(object? sender, RoutedEventArgs e) : void\n    - OnRemoveRowClicked(object? sender, RoutedEventArgs e) : void\n    - OnAddColClicked(object? sender, RoutedEventArgs e) : void\n    - OnRemoveColClicked(object? sender, RoutedEventArgs e) : void\n    - OnClearTableClicked(object? sender, RoutedEventArgs e) : void\n    - GetColumnName(int colIndex) : string\n}\n\nclass MainViewModel {\n    + string Greeting { get; set; }\n}\n\nclass ViewModelBase {\n}\n\nclass SpreadsheetEngine {\n    - readonly Dictionary&lt;string, string&gt; _expressions\n    - readonly Dictionary&lt;string, double&gt; _cache\n    - readonly HashSet&lt;string&gt; _visited\n    + Clear() : void\n    + SetExpression(string cellName, string expression) : void\n    + GetExpression(string cellName) : string\n    + EvaluateCell(string cellName) : string\n}\n\nclass SpreadsheetFile {\n    + int Rows { get; set; }\n    + int Columns { get; set; }\n    + Dictionary&lt;string, string&gt; Cells { get; set; }\n}\n\nclass Cell {\n    + string Name { get; set; }\n    + string Expression { get; set; }\n    + string Value { get; set; }\n    + HashSet&lt;string&gt; Dependencies { get; set; }\n}\n\nclass ExpressionEvaluator {\n    - readonly Func&lt;string, double&gt;? _resolveCell\n    - List&lt;string&gt; _tokens\n    - int _position\n    + ExpressionEvaluator(Func&lt;string, double&gt;? resolveCell = null)\n    + Evaluate(string expression) : double\n    - {static} Tokenize(string expression) : List&lt;string&gt;\n    - ParseExpression() : double\n    - ParseTerm() : double\n    - ParseUnary() : double\n    - ParsePower() : double\n    - ParsePrimary() : double\n    - {static} IsCellReference(string token) : bool\n    - Match(string expected) : bool\n    - MatchKeyword(string expected) : bool\n    - Previous() : string\n    + {static} Evaluate(string expression, Func&lt;string, double&gt; GetCellValue) : double\n}\n\nclass GoogleDriveService {\n    - readonly DriveService _drive\n    + GoogleDriveService()\n    + UploadJsonAsync(string fileName, string json) : Task&lt;string&gt;\n    + GetJsonFilesAsync() : Task&lt;List&lt;Google.Apis.Drive.v3.Data.File&gt;&gt;\n    + DownloadJsonAsync(string fileId) : Task&lt;string&gt;\n}\n\nApp --&gt; MainWindow : створює\nMainWindow --&gt; SpreadsheetEngine : використовує\nMainWindow --&gt; GoogleDriveService : використовує\nMainViewModel --|&gt; ViewModelBase\nSpreadsheetEngine ..&gt; ExpressionEvaluator : викликає Evaluate()\nSpreadsheetEngine ..&gt; SpreadsheetFile : серіалізує/десеріалізує\nSpreadsheetFile o-- Cell\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3u0fEGdowwIbrWp01CkL-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
